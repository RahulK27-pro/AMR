    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /TF1
        - /LaserScan1
        - /Odometry (EKF Filtered)1
        - /IMU Heading1
        - /IMU Acceleration1
        - /IMU Sensor Axes1
      Splitter Ratio: 0.5
    Tree Height: 445
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
