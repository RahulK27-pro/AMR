<?xml version="1.0"?>
<robot name="warehouse_agv">

  <!-- ═══════════════════════════════════════
       BASE BODY  –  cylindrical disk
       Spawn this robot at z=0.09 in your launch
       file so wheels sit exactly on the ground.
  ═══════════════════════════════════════ -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.22" length="0.12"/>
      </geometry>
      <material name="steel_blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.22" length="0.12"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.1078" ixy="0.0" ixz="0.0"
               iyy="0.1078" iyz="0.0"
               izz="0.1936"/>
    </inertial>
  </link>

  <!-- TOP DECK -->
  <link name="top_deck">
    <visual>
      <geometry>
        <cylinder radius="0.21" length="0.008"/>
      </geometry>
      <material name="dark_slate">
        <color rgba="0.12 0.12 0.18 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0"
               iyy="0.0005" iyz="0.0"
               izz="0.0009"/>
    </inertial>
  </link>

  <joint name="top_deck_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_deck"/>
    <origin xyz="0.0 0.0 0.064" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════
       LEFT DRIVE WHEEL  –  orange
  ═══════════════════════════════════════ -->
  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.45 0.0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.00043" ixy="0.0" ixz="0.0"
               iyy="0.00043" iyz="0.0"
               izz="0.00050"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.0 0.245 -0.035" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ═══════════════════════════════════════
       RIGHT DRIVE WHEEL  –  green
       (different colour from left so you can
       tell them apart in RViz)
  ═══════════════════════════════════════ -->
  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.00043" ixy="0.0" ixz="0.0"
               iyy="0.00043" iyz="0.0"
               izz="0.00050"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0.0 -0.245 -0.035" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ═══════════════════════════════════════
       FRONT CASTER  –  silver
  ═══════════════════════════════════════ -->
  <link name="front_caster">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0"
               iyy="0.000008" iyz="0.0"
               izz="0.000008"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.17 0.0 -0.06" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════
       REAR CASTER  –  silver
  ═══════════════════════════════════════ -->
  <link name="rear_caster">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="silver">
        <color rgba="0.8 0.8 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0"
               iyy="0.000008" iyz="0.0"
               izz="0.000008"/>
    </inertial>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.17 0.0 -0.06" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════
       LiDAR  –  cyan
  ═══════════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="cyan">
        <color rgba="0.0 0.85 0.9 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.00009" ixy="0.0" ixz="0.0"
               iyy="0.00009" iyz="0.0"
               izz="0.00014"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.09" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════
       CAMERA  –  red
  ═══════════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.025"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000003" ixy="0.0" ixz="0.0"
               iyy="0.000003" iyz="0.0"
               izz="0.000003"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.21 0.0 0.01" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ═══════════════════════════════════════
       GAZEBO PLUGINS
       sensors-system is intentionally ABSENT
       (world owns the render engine)
  ═══════════════════════════════════════ -->
  <gazebo>
    <!-- Differential drive + odometry -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.49</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>

    <!-- IMU system -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Joint state publisher  ← THIS fixes wheel visibility in RViz.
         Publishes wheel joint positions so robot_state_publisher
         can compute and broadcast the wheel TF frames. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- IMU sensor -->
  <gazebo reference="base_link">
    <sensor name="agv_imu" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev><bias_mean>0.0001</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- LiDAR sensor -->
  <gazebo reference="lidar_link">
    <sensor name="agv_lidar" type="gpu_lidar">
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="agv_camera" type="camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.1</near><far>100</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- Surface properties -->
  <gazebo reference="left_wheel">
    <mu1>1.2</mu1><mu2>1.2</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
    <slip1>0.002</slip1><slip2>0.0</slip2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.2</mu1><mu2>1.2</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
    <slip1>0.002</slip1><slip2>0.0</slip2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <gazebo reference="front_caster">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
  </gazebo>

  <gazebo reference="rear_caster">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>1.0</kd>
  </gazebo>

</robot>