        <visual name="vis"><geometry><box><size>0.45 0.45 0.75</size></box></geometry><material><ambient>0.18 0.35 0.65 1</ambient><diffuse>0.20 0.40 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Medical Equipment Trolley (Parked along South Wall outside Nurses' Station) -->
    <!-- 0.8m x 0.45m x 0.85m — Baseline parked obstacle (intersects LiDAR z = 0.155m) -->
    <model name="corridor_medical_trolley">
      <static>true</static>
      <pose>1.80 -0.72 0.425 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.80 0.45 0.85</size></box></geometry></collision>
        <!-- Metallic cart body -->
        <visual name="vis_body">
          <geometry><box><size>0.80 0.45 0.85</size></box></geometry>
          <material><ambient>0.65 0.68 0.72 1</ambient><diffuse>0.70 0.75 0.78 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <!-- Blue drawer accent -->
        <visual name="vis_drawers">
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><box><size>0.82 0.46 0.30</size></box></geometry>
          <material><ambient>0.18 0.38 0.65 1</ambient><diffuse>0.22 0.42 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor Plants (West & East Terminal Ends) -->
    <model name="corridor_plant_west">
      <static>true</static>
      <pose>-7.45 0.0 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.22</radius><length>0.80</length></cylinder></geometry></collision>
        <visual name="vis_pot">
          <pose>0 0 -0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.65 0.38 0.22 1</ambient><diffuse>0.70 0.42 0.25 1</diffuse></material>
        </visual>
        <visual name="vis_plant">
          <pose>0 0 0.20 0 0 0</pose>
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>0.15 0.55 0.20 1</ambient><diffuse>0.18 0.62 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_plant_east">
      <static>true</static>
      <pose>7.45 0.0 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.22</radius><length>0.80</length></cylinder></geometry></collision>
        <visual name="vis_pot">
          <pose>0 0 -0.15 0 0 0</pose>
          <geometry><cylinder><radius>0.20</radius><length>0.45</length></cylinder></geometry>
          <material><ambient>0.65 0.38 0.22 1</ambient><diffuse>0.70 0.42 0.25 1</diffuse></material>
        </visual>
        <visual name="vis_plant">
          <pose>0 0 0.20 0 0 0</pose>
