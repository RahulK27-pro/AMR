<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hospital">

    <!-- ============================================================ -->
    <!-- PHYSICS ENGINE CONFIGURATION                                 -->
    <!-- ============================================================ -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required plugins for Gazebo Sim (Harmonic / Garden) -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ============================================================ -->
    <!-- INDOOR HOSPITAL LIGHTING                                     -->
    <!-- Clean, sterile, evenly distributed soft illumination         -->
    <!-- ============================================================ -->

    <!-- Ambient fill light -->
    <light name="hospital_ambient" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.58 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1.0</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <!-- Corridor Ceiling Lights (4 panels along main 2m corridor) -->
    <light name="corridor_light_1" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-5.0 0 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="corridor_light_2" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-1.5 0 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="corridor_light_3" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>2.0 0 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="corridor_light_4" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>5.5 0 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Top Rooms Ceiling Lights -->
    <light name="r1_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-6.3 3.5 2.8 0 0 0</pose>
      <diffuse>0.90 0.92 0.95 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="r2_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-3.1 3.5 2.8 0 0 0</pose>
      <diffuse>0.90 0.92 0.95 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="dr_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>0.0 3.5 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="lab_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>3.1 3.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.97 1.0 1</diffuse>
      <attenuation><range>8</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="sc_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>6.3 3.5 2.8 0 0 0</pose>
      <diffuse>0.90 0.92 0.95 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Bottom Rooms Ceiling Lights -->
    <light name="ph_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-6.2 -3.5 2.8 0 0 0</pose>
      <diffuse>0.90 0.92 0.95 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="rw_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>-1.9 -3.5 2.8 0 0 0</pose>
      <diffuse>0.95 0.93 0.90 1</diffuse>
      <attenuation><range>10</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="ns_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>2.2 -3.5 2.8 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="ut_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>5.1 -3.5 2.8 0 0 0</pose>
      <diffuse>0.88 0.90 0.92 1</diffuse>
      <attenuation><range>8</range><constant>0.5</constant><linear>0.1</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <light name="toilet_light" type="point">
      <cast_shadows>false</cast_shadows>
      <pose>7.1 -3.5 2.8 0 0 0</pose>
      <diffuse>0.88 0.90 0.92 1</diffuse>
      <attenuation><range>6</range><constant>0.6</constant><linear>0.12</linear><quadratic>0.02</quadratic></attenuation>
    </light>

    <!-- ============================================================ -->
    <!-- GROUND PLANE — Clean Clinical Hospital Flooring               -->
    <!-- 16m (X: -8 to +8) x 12m (Y: -6 to +6)                        -->
    <!-- ============================================================ -->
    <model name="hospital_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16.0 12.0</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.80 0.82 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- PERIMETER WALLS (Height: 2.4m, Thickness: 0.15m)             -->
    <!-- Center of floor is (0, 0). X: [-8, 8], Y: [-6, 6]           -->
    <!-- ============================================================ -->

    <!-- North Outer Wall -->
    <model name="wall_perimeter_north">
      <static>true</static>
      <pose>0 5.925 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16.0 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16.0 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Outer Wall -->
    <model name="wall_perimeter_west">
      <static>true</static>
      <pose>-7.925 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 12.0 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 12.0 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Outer Wall -->
    <model name="wall_perimeter_east">
      <static>true</static>
      <pose>7.925 0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 12.0 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 12.0 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Outer Wall (West Segment - left of Main Entrance) -->
    <!-- Entrance opening: 1.2m clear width from X = -2.55 to -1.35 -->
    <model name="wall_perimeter_south_west">
      <static>true</static>
      <pose>-5.275 -5.925 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.45 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.45 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Outer Wall (East Segment - right of Main Entrance) -->
    <model name="wall_perimeter_south_east">
      <static>true</static>
      <pose>3.325 -5.925 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>9.35 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>9.35 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- NORTH CORRIDOR WALL (Separates Top Rooms from 2.0m Corridor) -->
    <!-- Centerline Y = +1.075, thickness 0.15, height 2.4m           -->
    <!-- 0.9m door openings for R1, R2, DR, LAB, SC                   -->
    <!-- ============================================================ -->

    <!-- Segment 1: Left of R1 door (X: -7.85 to -5.75) -->
    <model name="wall_nc_seg1">
      <static>true</static>
      <pose>-6.80 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.10 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.10 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 2: Between R1 & R2 doors (X: -4.85 to -2.55) -->
    <model name="wall_nc_seg2">
      <static>true</static>
      <pose>-3.70 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.30 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.30 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 3: Between R2 & DR doors (X: -1.65 to -1.45) -->
    <model name="wall_nc_seg3">
      <static>true</static>
      <pose>-1.55 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.20 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.20 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 4: Between DR & LAB doors (X: -0.55 to +1.70) -->
    <model name="wall_nc_seg4">
      <static>true</static>
      <pose>0.575 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.25 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.25 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 5: Between LAB & SC doors (X: +2.60 to +4.85) -->
    <model name="wall_nc_seg5">
      <static>true</static>
      <pose>3.725 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.25 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.25 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 6: Right of SC door (X: +5.75 to +7.85) -->
    <model name="wall_nc_seg6">
      <static>true</static>
      <pose>6.80 1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.10 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.10 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- TOP ROOMS PARTITION WALLS (Running North-South in Y)         -->
    <!-- Length: 4.70m, Y center: +3.50m, Z center: 1.2m             -->
    <!-- ============================================================ -->

    <!-- Partition between R1 (Patient Room 1) and R2 (Patient Room 2) -->
    <model name="wall_part_r1_r2">
      <static>true</static>
      <pose>-4.725 3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between R2 (Patient Room 2) and DR (Doctor's Room) -->
    <model name="wall_part_r2_dr">
      <static>true</static>
      <pose>-1.575 3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between DR (Doctor's Room) and LAB (Laboratory) -->
    <model name="wall_part_dr_lab">
      <static>true</static>
      <pose>1.575 3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between LAB (Laboratory) and SC (Sample Collection) -->
    <model name="wall_part_lab_sc">
      <static>true</static>
      <pose>4.725 3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- SOUTH CORRIDOR WALL (Separates Bottom Rooms from Corridor)   -->
    <!-- Centerline Y = -1.075, thickness 0.15, height 2.4m           -->
    <!-- Doors: PH (0.9m), RW (1.6m passage), NS (0.9m), UT (0.9m),   -->
    <!--        Toilet M (0.9m)                                       -->
    <!-- ============================================================ -->

    <!-- Segment 1: Left of Pharmacy door (X: -7.85 to -5.55) -->
    <model name="wall_sc_seg1">
      <static>true</static>
      <pose>-6.70 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.30 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.30 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 2: Between PH door and RW opening (X: -4.65 to -2.75) -->
    <model name="wall_sc_seg2">
      <static>true</static>
      <pose>-3.70 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.90 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.90 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 3: Between RW opening and NS door (X: -1.15 to +0.75) -->
    <model name="wall_sc_seg3">
      <static>true</static>
      <pose>-0.20 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.90 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.90 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 4: Between NS door and UT door (X: +1.65 to +3.90) -->
    <model name="wall_sc_seg4">
      <static>true</static>
      <pose>2.775 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.25 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.25 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 5: Between UT door and Toilet door (X: +4.80 to +6.50) -->
    <model name="wall_sc_seg5">
      <static>true</static>
      <pose>5.65 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.70 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.70 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segment 6: Right of Toilet door to East Wall (X: +7.40 to +7.85) -->
    <model name="wall_sc_seg6">
      <static>true</static>
      <pose>7.625 -1.075 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.45 0.15 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.45 0.15 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- BOTTOM ROOMS PARTITION WALLS (Running North-South in Y)      -->
    <!-- Length: 4.70m, Y center: -3.50m, Z center: 1.2m             -->
    <!-- ============================================================ -->

    <!-- Partition between Pharmacy (PH) and Reception (RW) -->
    <model name="wall_part_ph_rw">
      <static>true</static>
      <pose>-4.525 -3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between Reception (RW) and Nurses' Station (NS) -->
    <model name="wall_part_rw_ns">
      <static>true</static>
      <pose>0.625 -3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 4.70 2.4</size></box></geometry>
          <material><ambient>0.85 0.85 0.83 1</ambient><diffuse>0.88 0.88 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Partition between Nurses' Station (NS) and Utility (UT) -->
    <model name="wall_part_ns_ut">
      <static>true</static>
      <pose>3.775 -3.50 1.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 4.70 2.4</size></box></geometry></collision>
